{
  "permissions": {
    "allow": [
      "Bash(pnpm dev *)",
      "Bash(pnpm build *)",
      "Bash(pnpm start *)",
      "Bash(pnpm format *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm knip *)",
      "Bash(pnpm test *)",
      "Bash(pnpm check *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-format.sh",
            "statusMessage": "Linting and formatting..."
          }
        ]
      }
    ]
  }
}
